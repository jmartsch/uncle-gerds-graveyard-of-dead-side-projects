# Copy to .env.sprite (deployed to the museum Sprite as .env) or to .env (local development).

# --- Museum ---------------------------------------------------------------
# Needed for "Rescan GitHub" and real revivals. Open the museum once with ?key=<ADMIN_KEY>.
ADMIN_KEY=
# Lets the curator create ugm-exhibit-* Sprites. The only secret that lives on the museum Sprite.
SPRITES_TOKEN=

# --- Curator --------------------------------------------------------------
# Hand-pick exhibits (owner/repo, comma separated). Empty = pick dead public repos automatically.
EXHIBIT_REPOS=
MAX_EXHIBITS=6
# Guest museums (any GitHub user via /u/<name>): scans per hour and max queue length
GUEST_SCANS_PER_HOUR=30
GUEST_QUEUE_MAX=10
DEAD_AFTER_DAYS=365
# Private repos are never shown automatically, because the museum URL is public.
INCLUDE_PRIVATE=0
OLLAMA_MODEL=kimi-k3
JEV_MODEL=jev-latest

# --- Revival --------------------------------------------------------------
EXHIBIT_PREFIX=ugm-exhibit-
REVIVE_ATTEMPTS=2
REVIVE_TIMEOUT_MIN=15
# Optional: --model for Claude Code on the exhibit Sprite
REVIVE_MODEL=
# Fallback if Claude Code cannot use the Anthropic connector: a token from `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=

# --- Connector overrides (normally discovered via https://api.sprites.dev/v1/gateway/list) ---
# GW_GITHUB=https://api.sprites.dev/v1/gateway/github/<connection_id>
# GW_OLLAMA=
# GW_TYPESAFE=
# GW_ANTHROPIC=

# --- Local development only (outside a Sprite the gateway answers 401) ----
# FIXTURES=1
# GITHUB_TOKEN=        e.g. the output of: gh auth token
# OLLAMA_API_KEY=
# TYPESAFE_API_KEY=
